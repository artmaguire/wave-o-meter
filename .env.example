# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Compose reads these automatically.

# Access gate
GATE_ENABLED=1
GATE_ANSWER=Dmitrius
# Generate a long random value, e.g.:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
GATE_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=1
