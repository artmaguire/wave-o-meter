# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Compose reads these automatically.

# Access gate
GATE_ENABLED=1
# Your gate answer — set your real one in .env, never commit it.
GATE_ANSWER=your-answer-here
# Signing key for session cookies (REQUIRED for stable sessions).
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
GATE_SECRET=change-me-to-a-long-random-string
# Send the gate cookie only over HTTPS (recommended for any public URL).
COOKIE_SECURE=1
# If behind a reverse proxy, list its IP(s) so client-IP rate-limiting can
# trust X-Forwarded-For. Leave empty if the app is directly exposed.
TRUSTED_PROXIES=
